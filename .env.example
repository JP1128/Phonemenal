# Phonemer environment configuration. Copy to `.env` and fill in.

# Required for Phase 3 — LLM translation + calibration analysis.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# PHONEMER_DEVICE=cpu        # or "mps" on Apple Silicon
# PHONEMER_VAD=silero        # or "webrtc"
# PHONEMER_DB_PATH=data/phonemer.db
# PHONEMER_AUDIO_DIR=data/audio
# PHONEMER_TRANSLATION_MODEL=claude-sonnet-4-6
# PHONEMER_ANALYSIS_MODEL=claude-opus-4-7
